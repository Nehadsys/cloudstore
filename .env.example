FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string

# SQLite for dev (default). For production on the VM, switch to MySQL:
# DATABASE_URL=mysql+pymysql://cloudstore:password@localhost/cloudstore
DATABASE_URL=sqlite:///cloudstore.db

# Absolute path on the VM (e.g. /var/cloudstore/uploads).
# On Windows dev, leave blank to use ./uploads relative to project root.
UPLOAD_FOLDER=

# Max upload size in bytes (default 100 MB)
MAX_CONTENT_LENGTH=104857600
